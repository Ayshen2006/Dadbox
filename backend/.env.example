# ==============================================================================
# DadBox Backend Environment Configuration
# ==============================================================================

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-use-a-strong-secret-key
PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
POSTGRES_USER=dadbox_user
POSTGRES_PASSWORD=dadbox_password
POSTGRES_DB=dadbox_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Connection URI
DATABASE_URL=postgresql://dadbox_user:dadbox_password@localhost:5432/dadbox_db
