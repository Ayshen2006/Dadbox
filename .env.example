# ==============================================================================
# DadBox Environment Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env) and update values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Flask)
# ------------------------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-use-a-strong-secret-key
PORT=5000

# CORS Configuration (Frontend origin allowed to access API)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=dadbox_user
POSTGRES_PASSWORD=dadbox_password
POSTGRES_DB=dadbox_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URI:
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://dadbox_user:dadbox_password@localhost:5432/dadbox_db

# ------------------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# Note: Vite environment variables must start with VITE_
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
